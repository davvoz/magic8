{
  "name": "magic8",
  "version": "0.9.0",
  "private": true,
  "description": "Canvas-rendered collectible card game engine in vanilla JavaScript",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "serve": "node tools/dev-server.js",
    "simulate": "node tools/simulate.js",
    "lint": "eslint src test tools"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0"
  }
}
